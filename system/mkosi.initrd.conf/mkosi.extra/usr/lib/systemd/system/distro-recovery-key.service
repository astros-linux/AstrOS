[Unit]
# inspiration from https://raw.githubusercontent.com/GNOME/gnome-build-meta/refs/heads/master/files/gnomeos/generate-initramfs/modules/50-repart/enable-encryption.service
Description=Enroll Root Recovery Key
ConditionPathExists=/etc/initrd-release
ConditionSecurity=tpm2
DefaultDependencies=no
# run inside enter-initrd phase because else the root key refuses to unseal
After=systemd-repart.service systemd-pcrphase-initrd.service tpm2.target
Before=initrd.target shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/distro/recovery-key.sh
