enable distro-firstboot.service
enable flathub-fix.service
enable flatpak-update.timer
enable gsettings-schemas-fix.service

enable NetworkManager.service
enable NetworkManager-wait-online.service
disable systemd-networkd.service
disable systemd-networkd.socket
disable systemd-networkd-wait-online.service
enable cosmic-greeter.service
enable bluetooth.service
enable tuned-ppd.service
enable systemd-timesyncd.service
enable avahi-daemon.service
enable cups.service
enable apparmor.service

# the following services are enabled via separated .conf files. E.g. /usr/lib/systemd/system/sysinit.target.d/10-extensions.conf
disable systemd-confext.service
disable systemd-sysext.service
