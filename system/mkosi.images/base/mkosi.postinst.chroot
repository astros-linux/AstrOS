#!/bin/bash
set -e

# branding
(
  . /usr/lib/os-release
  cat >/usr/lib/os-release <<EOF
NAME="AstrOS"
PRETTY_NAME="AstrOS"
ID="astros"
ID_LIKE="$ID"
VERSION_ID="$IMAGE_VERSION"
ANSI_COLOR="38;2;185;113;251"
HOME_URL="https://astros-linux.org/"
DOCUMENTATION_URL="https://astros-linux.org/astros/"
EOF
)

# https://wiki.archlinux.org/title/COSMIC#SSH_AUTH_SOCK_not_set
systemctl enable --global gcr-ssh-agent.socket oo7-daemon.service

# disable soft-reboot (base /etc is a confext)
ln -sf /dev/null /usr/lib/systemd/system/soft-reboot.target
ln -sf /dev/null /usr/lib/systemd/system/systemd-soft-reboot.service
