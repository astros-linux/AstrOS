# @generated by `tine`; configure this project in tine.toml instead.

[cells]
prelude = prelude
none = none
root = .
tine = tine

[cell_aliases]
config = prelude
toolchains = tine
fbsource = none

[external_cells]
prelude = bundled

[parser]
target_platform_detector_spec = target:root//...->tine//platforms:default target:tine//...->tine//platforms:default

[build]
execution_platforms = tine//platforms:default

[project]
ignore = **/.git, **/.jj, **/.hg, **/.svn

[buck2]
materializations = deferred
sqlite_materializer_state = true
sqlite_dep_file_state = true
defer_write_actions = true
